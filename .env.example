# Copy to .env and fill in. .env is git-ignored: it holds passwords, never commit it.
# On the server, update.sh creates /root/common/env/airrex.env from this file; POSTGRES_PASSWORD comes from
# the shared /root/common/.env (see RetinueSoft/VpsSetup).

# ---- PostgreSQL (agent accounts, logins, quotes) ----
# Local development: `docker compose up -d postgres` starts airrex-postgres on 127.0.0.1:5436.
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_DB=airrex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Or one connection string instead of the five lines above:
# DATABASE_URL=postgres://postgres:<password>@localhost:5436/airrex
# POSTGRES_SSL=false
# Port on the server itself (127.0.0.1 only) for SSH-tunnel access with pgAdmin/DBeaver.
POSTGRES_HOST_PORT=5436

# ---- Server (docker-compose) ----
# Port on the server (127.0.0.1 only) for the app. The common Caddy proxies the domain to it.
APP_HOST_PORT=18087
# App image version from ghcr.io: "latest" or a build tag like sha-1a2b3c4 (set by update.sh).
APP_IMAGE_TAG=latest
TZ=UTC

# Live prices from Google Flights (https://serpapi.com/manage-api-key). Leave empty for demo fares.
SERPAPI_API_KEY=

# Currency for SerpApi prices (default INR).
# SERPAPI_CURRENCY=INR

# How long search results are reused before using another paid search (default 720 = 12 hours with a live source).
# SEARCH_CACHE_MINUTES=720

# Show clearly labelled demo fares if the live source fails (quota used up, outage). Default false.
# FALLBACK_TO_DEMO=false

# Approximate cheapest price per day for the "Cheapest dates" calendar (free).
# Join Travelpayouts, connect the Aviasales programme, copy the API token from your profile.
TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKET=in

# ---- Agent plan (shown on the agent pages) ----
# VITE_AGENT_PLAN_PRICE=₹999/month
# Free trial length for new agents (keep both the same).
# AGENT_TRIAL_DAYS=30

# Key that encrypts agents' saved passengers (passport details) in the database. Without it, agents can still scan
# passports and copy details, but can't save passengers. 32 random bytes in base64; create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and back it up separately from the database: without it, saved passengers can't be read.
PASSENGER_DATA_KEY=
# VITE_AGENT_TRIAL_DAYS=30
# Quotes kept per agency; older ones are removed when a new quote is saved (keep both the same).
# MAX_QUOTES_PER_AGENT=20
# VITE_MAX_QUOTES_PER_AGENT=20
# Your contact for renewals (WhatsApp digits with country code, e.g. 919876543210).
# VITE_SUPPORT_WHATSAPP=
# VITE_SUPPORT_EMAIL=
# Set to true only behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
# TRUST_PROXY=false

# Optional alternative source.
# DUFFEL_ACCESS_TOKEN=
