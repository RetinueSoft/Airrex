# Copy to .env and fill in. .env is git-ignored.

# Live prices from Google Flights (https://serpapi.com/manage-api-key). Leave empty for demo fares.
SERPAPI_API_KEY=

# Currency for SerpApi prices (default INR).
# SERPAPI_CURRENCY=INR

# How long search results are reused before using another paid search (default 720 = 12 hours with a live source).
# SEARCH_CACHE_MINUTES=720

# Show clearly labelled demo fares if the live source fails (quota used up, outage). Default false.
# FALLBACK_TO_DEMO=false

# Approximate cheapest price per day for the "Cheapest dates" calendar (free).
# Join Travelpayouts, connect the Aviasales programme, copy the API token from your profile.
TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKET=in

# ---- Agent plan (shown on the agent pages) ----
# VITE_AGENT_PLAN_PRICE=₹999/month
# Free trial length for new agents (keep both the same).
# AGENT_TRIAL_DAYS=30
# VITE_AGENT_TRIAL_DAYS=30
# Quotes kept per agency; older ones are removed when a new quote is saved (keep both the same).
# MAX_QUOTES_PER_AGENT=20
# VITE_MAX_QUOTES_PER_AGENT=20
# Your contact for renewals (WhatsApp digits with country code, e.g. 919876543210).
# VITE_SUPPORT_WHATSAPP=
# VITE_SUPPORT_EMAIL=
# Set to true only behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
# TRUST_PROXY=false

# Optional alternative source.
# DUFFEL_ACCESS_TOKEN=
