# Settings for the server. update.sh creates /root/common/env/airrex.env from this file on the first run
# and later adds any new settings from here (your values are never overwritten). It holds API keys: never commit it.
# Shared settings (database password, GitHub token, Azure backup URL) are in /root/common/.env, see RetinueSoft/VpsSetup.
# The database host, port and user inside Docker are fixed in docker-compose.yml; nothing to set here.

# Port on the server (127.0.0.1 only) for the app. The common Caddy proxies airrex.retinuesoft.com to it:
# keep it equal to the port in VpsSetup caddy/sites/airrex.caddy.
APP_HOST_PORT=18087

# The PostgreSQL password (user "postgres") is POSTGRES_PASSWORD in /root/common/.env, shared by all apps.
POSTGRES_DB=airrex
# Port on the server itself (127.0.0.1 only) for SSH-tunnel access with pgAdmin/DBeaver.
POSTGRES_HOST_PORT=5436

# Server time zone: only affects log timestamps. Can stay UTC.
TZ=UTC

# App image version from ghcr.io: "latest" or a build tag like sha-1a2b3c4 (set by update.sh).
APP_IMAGE_TAG=latest

# Live prices from Google Flights (https://serpapi.com/manage-api-key). Leave empty for demo fares.
SERPAPI_API_KEY=
# Currency for SerpApi prices (default INR).
# SERPAPI_CURRENCY=INR
# How long search results are reused before using another paid search (default 720 = 12 hours with a live source).
# SEARCH_CACHE_MINUTES=720
# Show clearly labelled demo fares if the live source fails (quota used up, outage). Default false.
# FALLBACK_TO_DEMO=false

# Approximate cheapest price per day for the "Cheapest dates" calendar (free).
# Join Travelpayouts, connect the Aviasales programme, copy the API token from your profile.
TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKET=in

# Key that encrypts agents' saved passengers (passport details) in the database. Without it, agents can still scan
# passports and copy details, but can't save passengers. 32 random bytes in base64; create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and back it up separately from the database: without it, saved passengers can't be read.
PASSENGER_DATA_KEY=

# Free trial length for new agents (default 30) and quotes kept per agency (default 20).
# AGENT_TRIAL_DAYS=30   (no longer used: new agencies wait for the site admin to activate them on /site-admin)

# Site admin (/site-admin, username rexl). The password is set on first visit after deployment with a one-time
# setup code printed in the server log. Set ADMIN_SETUP_CODE to choose that code yourself instead.
# ADMIN_SETUP_CODE=
# rexl's login mobile number (default 9943135008).
# SITE_ADMIN_MOBILE=9943135008
# MAX_QUOTES_PER_AGENT=20

# Optional alternative source.
# DUFFEL_ACCESS_TOKEN=

# ---- Build-time settings ----
# Built into the image by GitHub Actions from repository variables (see DEPLOY.md), not read from this file on the
# server. Keep VITE_AGENT_TRIAL_DAYS / VITE_MAX_QUOTES_PER_AGENT equal to the server values above.
# AIRREX_SITE_URL=https://airrex.retinuesoft.com
# VITE_AGENT_PLAN_PRICE=₹999/month
# VITE_AGENT_TRIAL_DAYS=30
# VITE_MAX_QUOTES_PER_AGENT=20
# VITE_SUPPORT_WHATSAPP=
# VITE_SUPPORT_EMAIL=

# ---- Local development only (copy this file to .env) ----
# `npm run db:up` starts airrex-postgres on 127.0.0.1:5436; `npm run dev` then connects with:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5436
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<any password; docker compose uses the same one for the new database>
# Or one connection string instead: DATABASE_URL=postgres://postgres:<password>@localhost:5436/airrex
# POSTGRES_SSL=false
# Set to true only behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto (the server sets it).
# TRUST_PROXY=false
